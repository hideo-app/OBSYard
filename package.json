{
  "name": "obsyard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:inject": "esbuild src-inject/studio.ts --bundle --format=iife --minify --target=chrome110 --outfile=src-tauri/gen/studio.js && esbuild src-inject/viewer.ts --bundle --format=iife --minify --target=chrome100 --outfile=src-tauri/gen/viewer.js",
    "dev": "npm run build:inject && vite",
    "build": "npm run build:inject && vue-tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
