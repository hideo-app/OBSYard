{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio",
  "description": "Pagina StreamYard (remota): solo i comandi pub_* dell'app",
  "windows": ["studio"],
  "remote": {
    "urls": ["https://streamyard.com/*", "https://*.streamyard.com/*", "http://127.0.0.1:*/*"]
  },
  "permissions": ["allow-pub-ready", "allow-pub-tracks", "allow-pub-signal", "allow-pub-thumbs"]
}
